{
	"name": "financas-sveltekit",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"surrealimport": " surreal import --conn http://127.0.0.1:8000 --ns test --db financas --user root --pass root ./src/lib/database/database.surql ",
		"surrealseed": "bun --bun ./src/lib/database/seed.ts",
		"surrealstart": "surreal start file:C:\\surrealdbstorage --strict --auth"
	},
	"devDependencies": {
		"@mdi/js": "^7.4.47",
		"@sveltejs/adapter-auto": "^3.2.1",
		"@sveltejs/kit": "^2.5.10",
		"@sveltejs/vite-plugin-svelte": "^3.1.1",
		"@types/node": "^20.14.8",
		"@typescript-eslint/eslint-plugin": "^7.11.0",
		"@typescript-eslint/parser": "^7.11.0",
		"autoprefixer": "^10.4.19",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.39.0",
		"flowbite": "^2.3.0",
		"flowbite-svelte": "^0.46.6",
		"flowbite-svelte-icons": "^1.6.1",
		"postcss": "^8.4.38",
		"postcss-load-config": "^5.1.0",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.3",
		"svelte": "latest",
		"svelte-check": "^3.8.0",
		"sveltekit-superforms": "^2.15.1",
		"tailwindcss": "^3.4.4",
		"tslib": "^2.6.2",
		"tw-bootstrap-grid-optimizer": "^1.0.2",
		"typescript": "^5.4.5",
		"vite": "^5.2.12",
		"vitest": "^1.6.0",
		"zod": "^3.23.8",
		"@tailwindcss/typography": "^0.5.13",
		"prettier-plugin-tailwindcss": "^0.6.4"
	},
	"dependencies": {
		"dotenv": "^16.4.5",
		"surrealdb.js": "1.0.0-beta.9"
	}
}
